# EduSec Security Monitoring System - Configuration
# Copy this file to .env to override default local settings

APP_NAME="EduSec"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database configuration
# By default, stored locally in backend/data/edusec.db
DATABASE_PATH="data/edusec.db"

# Server configuration
HOST="127.0.0.1"
PORT=8000
